app.post("/api/groups/:groupId/members", auth, requireMember, (req, res) => {
  const email = String(req.body.email || "").toLowerCase().trim();
  const target = db.prepare("SELECT id, name, email FROM users WHERE email = ?").get(email);
  if (!target) return res.status(404).json({ error: "User must register first" });

  try {
    db.prepare("INSERT INTO group_members(group_id, user_id) VALUES (?, ?)").run(req.groupId, target.id);
    audit(req.user.id, "group", req.groupId, "add_member", { targetUserId: target.id });
    res.status(201).json({ member: target });
  } catch {
    res.status(409).json({ error: "User is already a member" });
  }
});

app.get("/api/groups/:groupId", auth, requireMember, (req, res) => {
  const group = db.prepare("SELECT id, name, owner_id FROM groups WHERE id = ?").get(req.groupId);
  const members = db.prepare(`
    SELECT u.id, u.name, u.email
    FROM users u JOIN group_members gm ON gm.user_id = u.id
    WHERE gm.group_id = ?
  `).all(req.groupId);

  const expenses = db.prepare(`
    SELECT e.*, u.name AS payer_name
    FROM expenses e JOIN users u ON u.id = e.payer_id
    WHERE e.group_id = ? AND e.status = 'active'
    ORDER BY e.created_at DESC
  `).all(req.groupId);

  const shares = db.prepare(`
    SELECT es.expense_id, es.user_id, es.share_cents, u.name
    FROM expense_shares es JOIN users u ON u.id = es.user_id
    JOIN expenses e ON e.id = es.expense_id
    WHERE e.group_id = ?
  `).all(req.groupId);

  const cashPayments = db.prepare(`
    SELECT cp.*, p.name payer_name, r.name receiver_name
    FROM cash_payments cp
    JOIN users p ON p.id = cp.payer_id
    JOIN users r ON r.id = cp.receiver_id
    WHERE cp.group_id = ?
    ORDER BY cp.created_at DESC
  `).all(req.groupId);

  res.json({ group, members, expenses, shares, cashPayments });
});

function cents(value) {
  const n = Number(value);
  if (!Number.isFinite(n) || n <= 0) throw new Error("Invalid amount");
  return Math.round(n * 100);
}

function splitEqually(totalCents, userIds) {
  const base = Math.floor(totalCents / userIds.length);
  let remainder = totalCents - base * userIds.length;
  return userIds.map(id => {
    const share = base + (remainder-- > 0 ? 1 : 0);
    return { userId: id, shareCents: share };
  });
}

app.post("/api/expenses", auth, requireMember, (req, res) => {
  const description = String(req.body.description || "").trim();
  const category = String(req.body.category || "Other").trim().slice(0, 40);
  const payerId = Number(req.body.payerId);
  const participantIds = [...new Set((req.body.participantIds || []).map(Number))];

  if (!description || description.length > 120) return res.status(400).json({ error: "Invalid description" });
  if (!Number.isInteger(payerId) || !participantIds.length) return res.status(400).json({ error: "Payer and participants are required" });
  if (!isMember(payerId, req.groupId) || participantIds.some(id => !isMember(id, req.groupId))) {
    return res.status(400).json({ error: "Payer/participants must belong to the group" });
  }

  let amountCents;
  try { amountCents = cents(req.body.amount); } catch { return res.status(400).json({ error: "Invalid amount" }); }

  const shares = splitEqually(amountCents, participantIds);

  const tx = db.transaction(() => {
    const result = db.prepare(`
      INSERT INTO expenses(group_id, payer_id, description, amount_cents, category, source, created_by)
      VALUES (?, ?, ?, ?, ?, ?, ?)
    `).run(req.groupId, payerId, description, amountCents, category, req.body.source || "manual", req.user.id);

    const stmt = db.prepare("INSERT INTO expense_shares(expense_id, user_id, share_cents) VALUES (?, ?, ?)");
    for (const s of shares) stmt.run(result.lastInsertRowid, s.userId, s.shareCents);

    audit(req.user.id, "expense", result.lastInsertRowid, "create", {
      amountCents, payerId, participantIds, source: req.body.source || "manual"
    });
    return result.lastInsertRowid;
  });

  res.status(201).json({ expenseId: tx(), shares });
});

app.post("/api/cash-payments", auth, requireMember, (req, res) => {
  const payerId = Number(req.body.payerId);
  const receiverId = Number(req.body.receiverId);
  if (payerId !== req.user.id) return res.status(403).json({ error: "Only the payer can create their cash-payment claim" });
  if (!isMember(receiverId, req.groupId)) return res.status(400).json({ error: "Receiver is not in the group" });

  let amountCents;
  try { amountCents = cents(req.body.amount); } catch { return res.status(400).json({ error: "Invalid amount" }); }

  const result = db.prepare(`
    INSERT INTO cash_payments(group_id, payer_id, receiver_id, amount_cents, note)
    VALUES (?, ?, ?, ?, ?)
  `).run(req.groupId, payerId, receiverId, amountCents, String(req.body.note || "").slice(0, 200));

  audit(req.user.id, "cash_payment", result.lastInsertRowid, "claim", { amountCents, receiverId });
  res.status(201).json({ id: result.lastInsertRowid, status: "pending" });
});

app.post("/api/cash-payments/:id/respond", auth, (req, res) => {
  const id = Number(req.params.id);
  const payment = db.prepare("SELECT * FROM cash_payments WHERE id = ?").get(id);
  if (!payment || payment.receiver_id !== req.user.id) return res.status(404).json({ error: "Payment not found" });
  if (payment.status !== "pending") return res.status(409).json({ error: "Payment is already resolved" });

  const response = req.body.response;
  if (!["confirmed", "rejected"].includes(response)) return res.status(400).json({ error: "Invalid response" });

  const status = response === "confirmed" ? "confirmed" : "disputed";
  db.prepare(`
    UPDATE cash_payments SET status = ?, confirmed_at = CURRENT_TIMESTAMP WHERE id = ?
  `).run(status, id);

  audit(req.user.id, "cash_payment", id, response === "confirmed" ? "confirm" : "dispute");
  res.json({ ok: true, status });
});

app.get("/api/balances/:groupId", auth, requireMember, (req, res) => {
  const members = db.prepare(`
    SELECT u.id, u.name FROM users u
    JOIN group_members gm ON gm.user_id = u.id
    WHERE gm.group_id = ?
  `).all(req.groupId);

  const net = Object.fromEntries(members.map(m => [m.id, 0]));

  const expenses = db.prepare(`
    SELECT id, payer_id, amount_cents FROM expenses
    WHERE group_id = ? AND status = 'active'
  `).all(req.groupId);

  for (const e of expenses) {
    net[e.payer_id] += e.amount_cents;
    const shares = db.prepare("SELECT user_id, share_cents FROM expense_shares WHERE expense_id = ?").all(e.id);
    for (const s of shares) net[s.user_id] -= s.share_cents;
  }

  // Only confirmed cash payments affect balances.
  const cash = db.prepare(`
    SELECT payer_id, receiver_id, amount_cents
    FROM cash_payments WHERE group_id = ? AND status = 'confirmed'
  `).all(req.groupId);

  for (const p of cash) {
    net[p.payer_id] -= p.amount_cents;
    net[p.receiver_id] += p.amount_cents;
  }

  res.json({
    balances: members.map(m => ({ userId: m.id, name: m.name, cents: net[m.id] }))
  });
});

// Minimal natural-language parser for the prototype.
// It intentionally asks the user to confirm participants/amount when uncertain.
app.post("/api/ai/parse-expense", auth, (req, res) => {
  const text = String(req.body.text || "").trim();
  if (!text) return res.status(400).json({ error: "Text is required" });

  const amountMatch = text.match(/(?:rs\.?|mur)?\s*([0-9]+(?:[.,][0-9]{1,2})?)/i);
  const amount = amountMatch ? Number(amountMatch[1].replace(",", ".")) : null;

  const knownMembers = req.body.members || [];
  const lower = text.toLowerCase();
  const mentioned = knownMembers.filter(m => lower.includes(String(m.name).toLowerCase()));

  const needsConfirmation = !amount || mentioned.length < 1;

  res.json({
    suggestion: {
      description: text.slice(0, 100),
      amount,
      category: /taxi|uber|bus|transport/i.test(text) ? "Transport" :
                /food|dinner|lunch|restaurant|pizza/i.test(text) ? "Food" : "Other",
      participantIds: mentioned.map(m => m.id)
    },
    needsConfirmation,
    questions: [
      ...(!amount ? ["What was the amount?"] : []),
      ...(mentioned.length === 0 ? ["Who should be included in the split?"] : [])
    ]
  });
});

