:root {
  font-family: Inter, system-ui, Arial, sans-serif;
  color: #172033;
  background: #f5f7fb;
}
* { box-sizing: border-box; }
body { margin: 0; }
header {
  background: #171b3a;
  color: white;
  padding: 20px 5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
header h1 { margin: 0; }
header p { margin: 5px 0 0; opacity: .8; }
main { max-width: 1200px; margin: 30px auto; padding: 0 18px; }
.card {
  background: white;
  border-radius: 16px;
  padding: 22px;
  box-shadow: 0 8px 30px rgba(20,30,60,.08);
  margin-bottom: 20px;
}
.grid { display: grid; grid-template-columns: 320px 1fr; gap: 20px; }
input, select, textarea, button {
  font: inherit;
  border-radius: 10px;
  padding: 11px 12px;
  border: 1px solid #d9deea;
}
input, select, textarea { width: 100%; margin: 6px 0; }
button {
  background: #6257e8;
  color: white;
  border: 0;
  cursor: pointer;
  margin: 5px 0;
}
button.secondary { background: #e9ebf6; color: #303650; }
button.active { background: #6257e8; }
.tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
.tabs button { background: #eef0f7; color: #33394e; }
.tabs button.active { background: #6257e8; color: white; }
.inline { display: flex; gap: 6px; }
.inline input { min-width: 0; }
.groupItem {
  padding: 12px;
  border: 1px solid #e3e6ef;
  border-radius: 10px;
  margin: 8px 0;
  cursor: pointer;
}
.groupItem:hover { background: #f7f8fc; }
.formGrid { display: grid; gap: 8px; }
.balanceGrid { display: grid; grid-template-columns: repeat(auto-fit,minmax(140px,1fr)); gap: 10px; margin: 18px 0; }
.balance {
  padding: 15px;
  border-radius: 12px;
  background: #f3f5fb;
}
.positive { border-left: 4px solid #1c9b69; }
.negative { border-left: 4px solid #d85252; }
.expense, .cash, .auditItem {
  border: 1px solid #e2e5ee;
  padding: 14px;
  border-radius: 12px;
  margin: 10px 0;
}
.status { font-weight: 700; }
.pending { color: #b27800; }
.confirmed { color: #148459; }
.disputed { color: #c03939; }
.message { min-height: 20px; }
.security-list div { margin: 8px 0; }
pre { white-space: pre-wrap; background: #f5f6fa; padding: 15px; border-radius: 10px; }
label { font-weight: 600; }
@media(max-width: 800px) {
  .grid { grid-template-columns: 1fr; }
  header { align-items: flex-start; gap: 10px; flex-direction: column; }
}
