# Copy this file to .env.local

# Any long random string - signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Show verification codes on screen (great for demos). Set to false to hide them.
DEMO_SHOW_CODES=true

# Default currency for new groups.
DEFAULT_CURRENCY=MUR

# OPTIONAL: add a Claude API key to make the AI smarter at reading messy receipts
# and understanding free-form expense descriptions. The app works fine without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
